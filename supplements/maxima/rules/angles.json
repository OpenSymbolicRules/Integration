{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "5.3.7",
  "identity": "cas-supplement:maxima-axis-angle",
  "title": "Real integrals of the vertical-axis angle",
  "semantics": {
    "Int": "openmath:calculus1#int",
    "Atan2": "openmath:transc2#arctan",
    "Abs": "openmath:arith1#abs",
    "Im": "openmath:complex1#imaginary",
    "Power": "openmath:arith1#power",
    "Divide": "openmath:arith1#divide",
    "Multiply": "openmath:arith1#times",
    "Add": "openmath:arith1#plus",
    "Pi": "openmath:nums1#pi"
  },
  "rules": [
    {
      "id": 1,
      "pattern": ["Int", ["Atan2", 0, ["Add", "b.", "x_"]], "x_symbol"],
      "constraints": [["FreeQ", "b", "x"], ["EqQ", ["Im", "x"], 0], ["EqQ", ["Im", "b"], 0], ["Or", ["GtQ", ["Add", "b", "x"], 0], ["LtQ", ["Add", "b", "x"], 0]]],
      "result": ["Divide", ["Multiply", "Pi", ["Abs", ["Add", "b", "x"]]], 2],
      "derivation": "On either real sign interval the angle is pi/2 times the sign of its vertical coordinate. Differentiate the absolute value by the chain rule.",
      "provenance": {"method": "derived", "sources": [{"name": "Maxima", "revision": "1b81426deabf5f8366ce07aafc581944673a5467", "version": "5.50post", "locator": "tests/rtest_integrate.mac#L7377-L7380", "license": "See Maxima COPYING (GNU GPL version 2)."}]}
    },
    {
      "id": 2,
      "pattern": ["Int", ["Multiply", "x_", ["Atan2", 0, ["Add", "b.", ["Power", "x_", 2]]]], "x_symbol"],
      "constraints": [["FreeQ", "b", "x"], ["EqQ", ["Im", "x"], 0], ["EqQ", ["Im", "b"], 0], ["Or", ["GtQ", ["Add", "b", ["Power", "x", 2]], 0], ["LtQ", ["Add", "b", ["Power", "x", 2]], 0]]],
      "result": ["Divide", ["Multiply", "Pi", ["Abs", ["Add", "b", ["Power", "x", 2]]]], 4],
      "derivation": "On either real sign interval the angle is pi/2 times the sign of its vertical coordinate. Differentiate the absolute value by the chain rule.",
      "provenance": {"method": "derived", "sources": [{"name": "Maxima", "revision": "1b81426deabf5f8366ce07aafc581944673a5467", "version": "5.50post", "locator": "tests/rtest_integrate.mac#L7377-L7380", "license": "See Maxima COPYING (GNU GPL version 2)."}]}
    }
  ]
}
