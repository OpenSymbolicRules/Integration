      "expected_result": ["Divide", ["Multiply", 1, ["Power", "x", ["Divide", 3, 2]], ["BesselJ", ["Divide", 3, 2], ["Multiply", 2, "x"]]], 2],
      "comment": "On the real interval x > 0. Steps count applications of this supplement."
    },
