      "expected_result": [
        "Divide",
        ["Add",
          ["Multiply", -1, ["Cos", ["Add", ["Power", "x", 2], "x"]]],
          ["Multiply", -1, ["Multiply", ["Sqrt", ["Divide", "Pi", 2]], ["Add", ["Multiply", ["Cos", ["Divide", 1, 4]], ["FresnelS", ["Multiply", ["Sqrt", ["Divide", 2, "Pi"]], ["Add", "x", ["Divide", 1, 2]]]]], ["Multiply", -1, ["Sin", ["Divide", 1, 4]], ["FresnelC", ["Multiply", ["Sqrt", ["Divide", 2, "Pi"]], ["Add", "x", ["Divide", 1, 2]]]]]]]]
        ],
        2
      ]
    }
  ]
