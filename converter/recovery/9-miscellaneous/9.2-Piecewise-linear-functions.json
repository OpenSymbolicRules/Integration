{"source":"(* ::Code:: *)\r\nInt[u_^m_.,x_Symbol] :=\r\n  With[{c=Simplify[D[u,x]]},\r\n  1/c \\[Star] Subst[Int[x^m,x],x,u]] /;\r\nFreeQ[m,x] && PiecewiseLinearQ[u,x]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ","m","x"],["PiecewiseLinearQ","u","x"]],"id":1,"result":["With",["List",["Set","c",["Simplify",["D","u","x"]]]],["Star",["Multiply",1,["Power","c",-1]],["Subst",["Int",["Power","x","m"],"x"],"x","u"]]],"pattern":["Int",["Power","u_","m."],"x_symbol"]},"status":"candidate","ordinal":1,"required_heads":["PiecewiseLinearQ","Set","Star","Subst","With"]},
{"source":"(* ::Code:: *)\r\nInt[v_/u_,x_Symbol] :=\r\n  With[{a=Simplify[D[u,x]],b=Simplify[D[v,x]]},\r\n  b*x/a - (b*u-a*v)/a \\[Star] Int[1/u,x] /;\r\n NeQ[b*u-a*v,0]] /;\r\nPiecewiseLinearQ[u,v,x]\r\n\r\n\r\n","rule":{"constraints":[["PiecewiseLinearQ","u","v","x"]],"id":2,"result":["With",["List",["Set","a",["Simplify",["D","u","x"]]],["Set","b",["Simplify",["D","v","x"]]]],["Condition",["Add",["Multiply","b","x",["Power","a",-1]],["Multiply",-1,["Star",["Multiply",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]],["Int",["Multiply",1,["Power","u",-1]],"x"]]]],["NeQ",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],0]]],"pattern":["Int",["Multiply","v_",["Power","u_",-1]],"x_symbol"]},"status":"candidate","ordinal":2,"required_heads":["Condition","PiecewiseLinearQ","Set","Star","With"]},
{"source":"(* ::Code:: *)\r\nInt[v_^n_/u_,x_Symbol] :=\r\n  With[{a=Simplify[D[u,x]],b=Simplify[D[v,x]]},\r\n  v^n/(a*n) - (b*u-a*v)/a \\[Star] Int[v^(n-1)/u,x] /;\r\n NeQ[b*u-a*v,0]] /;\r\nPiecewiseLinearQ[u,v,x] && GtQ[n,0] && NeQ[n,1]\r\n\r\n\r\n","rule":{"constraints":[["PiecewiseLinearQ","u","v","x"],["GtQ","n",0],["NeQ","n",1]],"id":3,"result":["With",["List",["Set","a",["Simplify",["D","u","x"]]],["Set","b",["Simplify",["D","v","x"]]]],["Condition",["Add",["Multiply",["Power","v","n"],["Power",["Multiply","a","n"],-1]],["Multiply",-1,["Star",["Multiply",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]],["Int",["Multiply",["Power","v",["Add","n",["Multiply",-1,1]]],["Power","u",-1]],"x"]]]],["NeQ",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],0]]],"pattern":["Int",["Multiply",["Power","v_","n_"],["Power","u_",-1]],"x_symbol"]},"status":"candidate","ordinal":3,"required_heads":["Condition","PiecewiseLinearQ","Set","Star","With"]},
{"source":"(* ::Code:: *)\r\nInt[1/(u_*v_),x_Symbol] :=\r\n  With[{a=Simplify[D[u,x]],b=Simplify[D[v,x]]},\r\n  b/(b*u-a*v) \\[Star] Int[1/v,x] - a/(b*u-a*v) \\[Star] Int[1/u,x] /;\r\n NeQ[b*u-a*v,0]] /;\r\nPiecewiseLinearQ[u,v,x]\r\n\r\n\r\n","rule":{"constraints":[["PiecewiseLinearQ","u","v","x"]],"id":4,"result":["With",["List",["Set","a",["Simplify",["D","u","x"]]],["Set","b",["Simplify",["D","v","x"]]]],["Condition",["Add",["Star",["Multiply","b",["Power",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],-1]],["Int",["Multiply",1,["Power","v",-1]],"x"]],["Multiply",-1,["Star",["Multiply","a",["Power",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],-1]],["Int",["Multiply",1,["Power","u",-1]],"x"]]]],["NeQ",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],0]]],"pattern":["Int",["Multiply",1,["Power",["Multiply","u_","v_"],-1]],"x_symbol"]},"status":"candidate","ordinal":4,"required_heads":["Condition","PiecewiseLinearQ","Set","Star","With"]},
{"source":"(* ::Code:: *)\r\nInt[1/(u_*Sqrt[v_]),x_Symbol] :=\r\n  With[{a=Simplify[D[u,x]],b=Simplify[D[v,x]]},\r\n  2*ArcTan[Sqrt[v]/Rt[(b*u-a*v)/a,2]]/(a*Rt[(b*u-a*v)/a,2]) /;\r\n NeQ[b*u-a*v,0] && PosQ[(b*u-a*v)/a]] /;\r\nPiecewiseLinearQ[u,v,x]\r\n\r\n\r\n","rule":{"constraints":[["PiecewiseLinearQ","u","v","x"]],"id":5,"result":["With",["List",["Set","a",["Simplify",["D","u","x"]]],["Set","b",["Simplify",["D","v","x"]]]],["Condition",["Multiply",2,["Atan",["Multiply",["Sqrt","v"],["Power",["Rt",["Multiply",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]],2],-1]]],["Power",["Multiply","a",["Rt",["Multiply",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]],2]],-1]],["And",["NeQ",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],0],["PosQ",["Multiply",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]]]]]],"pattern":["Int",["Multiply",1,["Power",["Multiply","u_",["Sqrt","v_"]],-1]],"x_symbol"]},"status":"candidate","ordinal":5,"required_heads":["Condition","PiecewiseLinearQ","PosQ","Set","With"]},
{"source":"(* ::Code:: *)\r\nInt[1/(u_*Sqrt[v_]),x_Symbol] :=\r\n  With[{a=Simplify[D[u,x]],b=Simplify[D[v,x]]},\r\n  -2*ArcTanh[Sqrt[v]/Rt[-(b*u-a*v)/a,2]]/(a*Rt[-(b*u-a*v)/a,2]) /;\r\n NeQ[b*u-a*v,0] && NegQ[(b*u-a*v)/a]] /;\r\nPiecewiseLinearQ[u,v,x]\r\n\r\n\r\n","rule":{"constraints":[["PiecewiseLinearQ","u","v","x"]],"id":6,"result":["With",["List",["Set","a",["Simplify",["D","u","x"]]],["Set","b",["Simplify",["D","v","x"]]]],["Condition",["Multiply",-2,["Atanh",["Multiply",["Sqrt","v"],["Power",["Rt",["Multiply",-1,["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]],2],-1]]],["Power",["Multiply","a",["Rt",["Multiply",-1,["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]],2]],-1]],["And",["NeQ",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],0],["NegQ",["Multiply",["Add",["Multiply","b","u"],["Multiply",-1,"a","v"]],["Power","a",-1]]]]]],"pattern":["Int",["Multiply",1,["Power",["Multiply","u_",["Sqrt","v_"]],-1]],"x_symbol"]},"status":"candidate","ordinal":6,"required_heads":["Condition","NegQ","PiecewiseLinearQ","Set","With"]},
