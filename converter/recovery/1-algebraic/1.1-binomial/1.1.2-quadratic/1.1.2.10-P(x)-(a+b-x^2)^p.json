{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_+b_.*x_^2)^p_.,x_Symbol] :=\r\n  Int[ExpandIntegrand[Pq*(a+b*x^2)^p,x],x] /;\r\nFreeQ[{a,b},x] && PolyQ[Pq,x] && IGtQ[p,-2]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b"],"x"],["PolyQ","Pq","x"],["IGtQ","p",-2]],"id":1,"result":["Int",["ExpandIntegrand",["Multiply","Pq",["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"]],"x"],"x"],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p."]],"x_symbol"]},"status":"candidate","ordinal":1,"required_heads":["ExpandIntegrand","PolyQ"]},
{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_+b_.*x_^2)^p_,x_Symbol] :=\r\n  Int[x*PolynomialQuotient[Pq,x,x]*(a+b*x^2)^p,x] /;\r\nFreeQ[{a,b,p},x] && PolyQ[Pq,x] && EqQ[Coeff[Pq,x,0],0] && Not[MatchQ[Pq,x^m_.*u_. /; IntegerQ[m]]]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","p"],"x"],["PolyQ","Pq","x"],["EqQ",["Coeff","Pq","x",0],0],["Not",["MatchQ","Pq",["Condition",["Multiply",["Power","x","m."],"u."],["IntegerQ","m"]]]]],"id":2,"result":["Int",["Multiply","x",["PolynomialQuotient","Pq","x","x"],["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"]],"x"],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":2,"required_heads":["Coeff","Condition","MatchQ","PolyQ","PolynomialQuotient"]},
{"source":"(* ::Code:: *)\r\nInt[Px_*(a_+b_.*x_^2)^p_.,x_Symbol] :=\r\n  Int[PolynomialQuotient[Px,a+b*x^2,x]*(a+b*x^2)^(p+1),x] /;\r\nFreeQ[{a,b,p},x] && PolyQ[Px,x] && EqQ[PolynomialRemainder[Px,a+b*x^2,x],0]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","p"],"x"],["PolyQ","Px","x"],["EqQ",["PolynomialRemainder","Px",["Add","a",["Multiply","b",["Power","x",2]]],"x"],0]],"id":3,"result":["Int",["Multiply",["PolynomialQuotient","Px",["Add","a",["Multiply","b",["Power","x",2]]],"x"],["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]]],"x"],"pattern":["Int",["Multiply","Px_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p."]],"x_symbol"]},"status":"candidate","ordinal":3,"required_heads":["PolyQ","PolynomialQuotient","PolynomialRemainder"]},
{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_+b_.*x_^2)^p_,x_Symbol] :=\r\n  With[{A=Coeff[Pq,x,0],Q=PolynomialQuotient[Pq-Coeff[Pq,x,0],x^2,x]},\r\n  A*x*(a+b*x^2)^(p+1)/a + 1/a \\[Star] Int[x^2*(a+b*x^2)^p*(a*Q-A*b*(2*p+3)),x]] /;\r\nFreeQ[{a,b},x] && PolyQ[Pq,x^2] && ILtQ[p+1/2,0] && LtQ[Expon[Pq,x]+2*p+1,0]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b"],"x"],["PolyQ","Pq",["Power","x",2]],["ILtQ",["Add","p",["Multiply",1,["Power",2,-1]]],0],["LtQ",["Add",["Expon","Pq","x"],["Multiply",2,"p"],1],0]],"id":4,"result":["With",["List",["Set","A",["Coeff","Pq","x",0]],["Set","Q",["PolynomialQuotient",["Add","Pq",["Multiply",-1,["Coeff","Pq","x",0]]],["Power","x",2],"x"]]],["Add",["Multiply","A","x",["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]],["Power","a",-1]],["Star",["Multiply",1,["Power","a",-1]],["Int",["Multiply",["Power","x",2],["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"],["Add",["Multiply","a","Q"],["Multiply",-1,"A","b",["Add",["Multiply",2,"p"],3]]]],"x"]]]],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":4,"required_heads":["Coeff","Expon","PolyQ","PolynomialQuotient","Set","Star","With"]},
{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_+b_.*x_^2)^p_,x_Symbol] :=\r\n  With[{Q=PolynomialQuotient[Pq,a+b*x^2,x],\r\n        f=Coeff[PolynomialRemainder[Pq,a+b*x^2,x],x,0],\r\n        g=Coeff[PolynomialRemainder[Pq,a+b*x^2,x],x,1]},\r\n  (a*g-b*f*x)*(a+b*x^2)^(p+1)/(2*a*b*(p+1)) + \r\n  1/(2*a*(p+1)) \\[Star] Int[(a+b*x^2)^(p+1)*ExpandToSum[2*a*(p+1)*Q+f*(2*p+3),x],x]] /;\r\nFreeQ[{a,b},x] && PolyQ[Pq,x] && LtQ[p,-1]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b"],"x"],["PolyQ","Pq","x"],["LtQ","p",-1]],"id":5,"result":["With",["List",["Set","Q",["PolynomialQuotient","Pq",["Add","a",["Multiply","b",["Power","x",2]]],"x"]],["Set","f",["Coeff",["PolynomialRemainder","Pq",["Add","a",["Multiply","b",["Power","x",2]]],"x"],"x",0]],["Set","g",["Coeff",["PolynomialRemainder","Pq",["Add","a",["Multiply","b",["Power","x",2]]],"x"],"x",1]]],["Add",["Multiply",["Add",["Multiply","a","g"],["Multiply",-1,"b","f","x"]],["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]],["Power",["Multiply",2,"a","b",["Add","p",1]],-1]],["Star",["Multiply",1,["Power",["Multiply",2,"a",["Add","p",1]],-1]],["Int",["Multiply",["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]],["ExpandToSum",["Add",["Multiply",2,"a",["Add","p",1],"Q"],["Multiply","f",["Add",["Multiply",2,"p"],3]]],"x"]],"x"]]]],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":5,"required_heads":["Coeff","ExpandToSum","PolyQ","PolynomialQuotient","PolynomialRemainder","Set","Star","With"]},
{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_+b_.*x_^2)^p_,x_Symbol] :=\r\n  With[{q=Expon[Pq,x],e=Coeff[Pq,x,Expon[Pq,x]]},\r\n  e*x^(q-1)*(a+b*x^2)^(p+1)/(b*(q+2*p+1)) + \r\n  1/(b*(q+2*p+1)) \\[Star] Int[(a+b*x^2)^p*ExpandToSum[b*(q+2*p+1)*Pq-a*e*(q-1)*x^(q-2)-b*e*(q+2*p+1)*x^q,x],x]] /;\r\nFreeQ[{a,b,p},x] && PolyQ[Pq,x] && Not[LeQ[p,-1]]\r\n\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","p"],"x"],["PolyQ","Pq","x"],["Not",["LeQ","p",-1]]],"id":6,"result":["With",["List",["Set","q",["Expon","Pq","x"]],["Set","e",["Coeff","Pq","x",["Expon","Pq","x"]]]],["Add",["Multiply","e",["Power","x",["Add","q",["Multiply",-1,1]]],["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]],["Power",["Multiply","b",["Add","q",["Multiply",2,"p"],1]],-1]],["Star",["Multiply",1,["Power",["Multiply","b",["Add","q",["Multiply",2,"p"],1]],-1]],["Int",["Multiply",["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"],["ExpandToSum",["Add",["Multiply","b",["Add","q",["Multiply",2,"p"],1],"Pq"],["Multiply",-1,"a","e",["Add","q",["Multiply",-1,1]],["Power","x",["Add","q",["Multiply",-1,2]]]],["Multiply",-1,"b","e",["Add","q",["Multiply",2,"p"],1],["Power","x","q"]]],"x"]],"x"]]]],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":6,"required_heads":["Coeff","ExpandToSum","Expon","PolyQ","Set","Star","With"]}
