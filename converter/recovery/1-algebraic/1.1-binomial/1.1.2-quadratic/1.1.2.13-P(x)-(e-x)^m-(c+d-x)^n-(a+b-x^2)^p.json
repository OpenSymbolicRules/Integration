{"source":"(* ::Code:: *)\r\nInt[Px_*(e_.*x_)^m_.*(c_+d_.*x_)^n_.*(a_+b_.*x_^2)^p_.,x_Symbol] :=\r\n  Int[PolynomialQuotient[Px,c+d*x,x]*(e*x)^m*(c+d*x)^(n+1)*(a+b*x^2)^p,x] /;\r\nFreeQ[{a,b,c,d,e,m,n,p},x] && PolynomialQ[Px,x] && EqQ[PolynomialRemainder[Px,c+d*x,x],0]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","d","e","m","n","p"],"x"],["PolynomialQ","Px","x"],["EqQ",["PolynomialRemainder","Px",["Add","c",["Multiply","d","x"]],"x"],0]],"id":1,"result":["Int",["Multiply",["PolynomialQuotient","Px",["Add","c",["Multiply","d","x"]],"x"],["Power",["Multiply","e","x"],"m"],["Power",["Add","c",["Multiply","d","x"]],["Add","n",1]],["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"]],"x"],"pattern":["Int",["Multiply","Px_",["Power",["Multiply","e.","x_"],"m."],["Power",["Add","c_",["Multiply","d.","x_"]],"n."],["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p."]],"x_symbol"]},"status":"candidate","ordinal":1,"required_heads":["PolynomialQuotient","PolynomialRemainder"]},
