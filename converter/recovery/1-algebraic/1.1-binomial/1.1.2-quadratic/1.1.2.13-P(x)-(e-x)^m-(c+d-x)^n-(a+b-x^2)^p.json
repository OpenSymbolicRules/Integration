{"source":"(* ::Code:: *)\r\nInt[(e_.*x_)^m_*Px_/(Sqrt[c_+d_.*x_]*Sqrt[a_+b_.*x_^2]),x_Symbol] :=\r\n  With[{Px0=Coefficient[Px,x,0]},\r\n  Px0*(e*x)^(m+1)*Sqrt[c+d*x]*Sqrt[a+b*x^2]/(a*c*e*(m+1)) + \r\n  1/(2*a*c*e*(m+1)) \\[Star] Int[(e*x)^(m+1)/(Sqrt[c+d*x]*Sqrt[a+b*x^2])*\r\n    ExpandToSum[2*a*c*(m+1)*((Px-Px0)/x)-Px0*(a*d*(2*m+3)+2*b*c*(m+2)*x+b*d*(2*m+5)*x^2),x],x]]/;\r\nFreeQ[{a,b,c,d,e},x] && PolynomialQ[Px,x] && LtQ[m,-1]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","d","e"],"x"],["PolynomialQ","Px","x"],["LtQ","m",-1]],"id":3,"result":["With",["List",["Set","Px0",["Coefficient","Px","x",0]]],["Add",["Multiply","Px0",["Power",["Multiply","e","x"],["Add","m",1]],["Sqrt",["Add","c",["Multiply","d","x"]]],["Sqrt",["Add","a",["Multiply","b",["Power","x",2]]]],["Power",["Multiply","a","c","e",["Add","m",1]],-1]],["Star",["Multiply",1,["Power",["Multiply",2,"a","c","e",["Add","m",1]],-1]],["Int",["Multiply",["Power",["Multiply","e","x"],["Add","m",1]],["Power",["Multiply",["Sqrt",["Add","c",["Multiply","d","x"]]],["Sqrt",["Add","a",["Multiply","b",["Power","x",2]]]]],-1],["ExpandToSum",["Add",["Multiply",2,"a","c",["Add","m",1],["Add","Px",["Multiply",-1,"Px0"]],["Power","x",-1]],["Multiply",-1,"Px0",["Add",["Multiply","a","d",["Add",["Multiply",2,"m"],3]],["Multiply",2,"b","c",["Add","m",2],"x"],["Multiply","b","d",["Add",["Multiply",2,"m"],5],["Power","x",2]]]]],"x"]],"x"]]]],"pattern":["Int",["Multiply",["Power",["Multiply","e.","x_"],"m_"],"Px_",["Power",["Multiply",["Sqrt",["Add","c_",["Multiply","d.","x_"]]],["Sqrt",["Add","a_",["Multiply","b.",["Power","x_",2]]]]],-1]],"x_symbol"]},"status":"candidate","ordinal":3,"required_heads":["ExpandToSum","Set","Star","With"]},
