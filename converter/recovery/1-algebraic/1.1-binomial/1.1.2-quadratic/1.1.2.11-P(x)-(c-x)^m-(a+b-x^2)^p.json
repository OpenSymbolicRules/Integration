{"source":"(* ::Code:: *)\r\nInt[(c_.*x_)^m_.*P2_*(a_+b_.*x_^2)^p_.,x_Symbol] :=\r\n  With[{f=Coeff[P2,x,0],g=Coeff[P2,x,1],h=Coeff[P2,x,2]},\r\n  h*(c*x)^(m+1)*(a+b*x^2)^(p+1)/(b*c*(m+2*p+3)) /;\r\n EqQ[g,0] && EqQ[a*h*(m+1)-b*f*(m+2*p+3),0]] /;\r\nFreeQ[{a,b,c,m,p},x] && PolyQ[P2,x,2] && NeQ[m,-1]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","m","p"],"x"],["PolyQ","P2","x",2],["NeQ","m",-1]],"id":2,"result":["With",["List",["Set","f",["Coeff","P2","x",0]],["Set","g",["Coeff","P2","x",1]],["Set","h",["Coeff","P2","x",2]]],["Condition",["Multiply","h",["Power",["Multiply","c","x"],["Add","m",1]],["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]],["Power",["Multiply","b","c",["Add","m",["Multiply",2,"p"],3]],-1]],["And",["EqQ","g",0],["EqQ",["Add",["Multiply","a","h",["Add","m",1]],["Multiply",-1,"b","f",["Add","m",["Multiply",2,"p"],3]]],0]]]],"pattern":["Int",["Multiply",["Power",["Multiply","c.","x_"],"m."],"P2_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p."]],"x_symbol"]},"status":"candidate","ordinal":2,"required_heads":["Coeff","Condition","PolyQ","Set","With"]},
{"source":"(* ::Code:: *)\r\nInt[(c_.*x_)^m_.*Pq_*(a_+b_.*x_^2)^p_.,x_Symbol] :=\r\n  Int[ExpandIntegrand[(c*x)^m*Pq*(a+b*x^2)^p,x],x] /;\r\nFreeQ[{a,b,c,m},x] && PolyQ[Pq,x] && IGtQ[p,-2]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","m"],"x"],["PolyQ","Pq","x"],["IGtQ","p",-2]],"id":3,"result":["Int",["ExpandIntegrand",["Multiply",["Power",["Multiply","c","x"],"m"],"Pq",["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"]],"x"],"x"],"pattern":["Int",["Multiply",["Power",["Multiply","c.","x_"],"m."],"Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p."]],"x_symbol"]},"status":"candidate","ordinal":3,"required_heads":["ExpandIntegrand","PolyQ"]},
