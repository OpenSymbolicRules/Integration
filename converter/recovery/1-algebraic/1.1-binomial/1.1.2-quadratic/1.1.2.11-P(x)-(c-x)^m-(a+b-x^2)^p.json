{"source":"(* ::Code:: *)\r\nInt[(c_.*x_)^m_.*Pq_*(a_+b_.*x_^2)^p_.,x_Symbol] :=\r\n  With[{q=Expon[Pq,x]},\r\n  Coeff[Pq,x,q]/c^q \\[Star] Int[(c*x)^(m+q)*(a+b*x^2)^p,x] + \r\n  1/c^q \\[Star] Int[(c*x)^m*(a+b*x^2)^p*ExpandToSum[c^q*Pq-Coeff[Pq,x,q]*(c*x)^q,x],x] /;\r\n EqQ[q,1] || EqQ[m+q+2*p+1,0]] /;\r\nFreeQ[{a,b,c,m,p},x] && PolyQ[Pq,x] && Not[IGtQ[m,0] && ILtQ[p+1/2,0]]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","m","p"],"x"],["PolyQ","Pq","x"],["Not",["And",["IGtQ","m",0],["ILtQ",["Add","p",["Multiply",1,["Power",2,-1]]],0]]]],"id":9,"result":["With",["List",["Set","q",["Expon","Pq","x"]]],["Condition",["Add",["Star",["Multiply",["Coeff","Pq","x","q"],["Power",["Power","c","q"],-1]],["Int",["Multiply",["Power",["Multiply","c","x"],["Add","m","q"]],["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"]],"x"]],["Star",["Multiply",1,["Power",["Power","c","q"],-1]],["Int",["Multiply",["Power",["Multiply","c","x"],"m"],["Power",["Add","a",["Multiply","b",["Power","x",2]]],"p"],["ExpandToSum",["Add",["Multiply",["Power","c","q"],"Pq"],["Multiply",-1,["Coeff","Pq","x","q"],["Power",["Multiply","c","x"],"q"]]],"x"]],"x"]]],["Or",["EqQ","q",1],["EqQ",["Add","m","q",["Multiply",2,"p"],1],0]]]],"pattern":["Int",["Multiply",["Power",["Multiply","c.","x_"],"m."],"Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p."]],"x_symbol"]},"status":"candidate","ordinal":9,"required_heads":["Coeff","Condition","ExpandToSum","Expon","PolyQ","Set","Star","With"]},
