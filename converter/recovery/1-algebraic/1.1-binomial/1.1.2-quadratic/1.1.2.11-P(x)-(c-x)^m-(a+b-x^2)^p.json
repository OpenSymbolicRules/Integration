{"source":"(* ::Code:: *)\r\nInt[(c_.*x_)^m_.*Pq_*(a_+b_.*x_^2)^p_,x_Symbol] :=\r\n  With[{Q=PolynomialQuotient[Pq,a+b*x^2,x],\r\n        f=Coeff[PolynomialRemainder[Pq,a+b*x^2,x],x,0],\r\n        g=Coeff[PolynomialRemainder[Pq,a+b*x^2,x],x,1]},\r\n  (c*x)^m*(a+b*x^2)^(p+1)*(a*g-b*f*x)/(2*a*b*(p+1)) + \r\n  c/(2*a*b*(p+1)) \\[Star] Int[(c*x)^(m-1)*(a+b*x^2)^(p+1)*ExpandToSum[2*a*b*(p+1)*x*Q-a*g*m+b*f*(m+2*p+3)*x,x],x]] /;\r\nFreeQ[{a,b,c},x] && PolyQ[Pq,x] && LtQ[p,-1] && GtQ[m,0]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c"],"x"],["PolyQ","Pq","x"],["LtQ","p",-1],["GtQ","m",0]],"id":5,"result":["With",["List",["Set","Q",["PolynomialQuotient","Pq",["Add","a",["Multiply","b",["Power","x",2]]],"x"]],["Set","f",["Coeff",["PolynomialRemainder","Pq",["Add","a",["Multiply","b",["Power","x",2]]],"x"],"x",0]],["Set","g",["Coeff",["PolynomialRemainder","Pq",["Add","a",["Multiply","b",["Power","x",2]]],"x"],"x",1]]],["Add",["Multiply",["Power",["Multiply","c","x"],"m"],["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]],["Add",["Multiply","a","g"],["Multiply",-1,"b","f","x"]],["Power",["Multiply",2,"a","b",["Add","p",1]],-1]],["Star",["Multiply","c",["Power",["Multiply",2,"a","b",["Add","p",1]],-1]],["Int",["Multiply",["Power",["Multiply","c","x"],["Add","m",["Multiply",-1,1]]],["Power",["Add","a",["Multiply","b",["Power","x",2]]],["Add","p",1]],["ExpandToSum",["Add",["Multiply",2,"a","b",["Add","p",1],"x","Q"],["Multiply",-1,"a","g","m"],["Multiply","b","f",["Add","m",["Multiply",2,"p"],3],"x"]],"x"]],"x"]]]],"pattern":["Int",["Multiply",["Power",["Multiply","c.","x_"],"m."],"Pq_",["Power",["Add","a_",["Multiply","b.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":5,"required_heads":["Coeff","ExpandToSum","PolyQ","PolynomialQuotient","PolynomialRemainder","Set","Star","With"]},
