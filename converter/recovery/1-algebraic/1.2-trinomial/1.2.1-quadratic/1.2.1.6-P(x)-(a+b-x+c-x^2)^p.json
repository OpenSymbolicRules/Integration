{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_+b_.*x_+c_.*x_^2)^p_.,x_Symbol] :=\r\n  Int[ExpandIntegrand[Pq*(a+b*x+c*x^2)^p,x],x] /;\r\nFreeQ[{a,b,c},x] && PolyQ[Pq,x] && IGtQ[p,-2]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c"],"x"],["PolyQ","Pq","x"],["IGtQ","p",-2]],"id":1,"result":["Int",["ExpandIntegrand",["Multiply","Pq",["Power",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],"p"]],"x"],"x"],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a_",["Multiply","b.","x_"],["Multiply","c.",["Power","x_",2]]],"p."]],"x_symbol"]},"status":"candidate","ordinal":1,"required_heads":["ExpandIntegrand","PolyQ"]},
{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_.+b_.*x_+c_.*x_^2)^p_,x_Symbol] :=\r\n  Int[x*PolynomialQuotient[Pq,x,x]*(a+b*x+c*x^2)^p,x] /;\r\nFreeQ[{a,b,c,p},x] && PolyQ[Pq,x] && EqQ[Coeff[Pq,x,0],0] && Not[MatchQ[Pq,x^m_.*u_. /; IntegerQ[m]]]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","p"],"x"],["PolyQ","Pq","x"],["EqQ",["Coeff","Pq","x",0],0],["Not",["MatchQ","Pq",["Condition",["Multiply",["Power","x","m."],"u."],["IntegerQ","m"]]]]],"id":2,"result":["Int",["Multiply","x",["PolynomialQuotient","Pq","x","x"],["Power",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],"p"]],"x"],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a.",["Multiply","b.","x_"],["Multiply","c.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":2,"required_heads":["Coeff","Condition","MatchQ","PolyQ","PolynomialQuotient"]},
{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_+b_.*x_+c_.*x_^2)^p_,x_Symbol] :=\r\n  (a+b*x+c*x^2)^FracPart[p]/((4*c)^IntPart[p]*(b+2*c*x)^(2*FracPart[p])) \\[Star] Int[Pq*(b+2*c*x)^(2*p),x] /;\r\nFreeQ[{a,b,c,p},x] && PolyQ[Pq,x] && EqQ[b^2-4*a*c,0]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","p"],"x"],["PolyQ","Pq","x"],["EqQ",["Add",["Power","b",2],["Multiply",-1,4,"a","c"]],0]],"id":3,"result":["Star",["Multiply",["Power",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],["FracPart","p"]],["Power",["Multiply",["Power",["Multiply",4,"c"],["IntPart","p"]],["Power",["Add","b",["Multiply",2,"c","x"]],["Multiply",2,["FracPart","p"]]]],-1]],["Int",["Multiply","Pq",["Power",["Add","b",["Multiply",2,"c","x"]],["Multiply",2,"p"]]],"x"]],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a_",["Multiply","b.","x_"],["Multiply","c.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":3,"required_heads":["PolyQ","Star"]},
{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_.+b_.*x_+c_.*x_^2)^p_,x_Symbol] :=\r\n  With[{Q=PolynomialQuotient[Pq,a+b*x+c*x^2,x],\r\n        f=Coeff[PolynomialRemainder[Pq,a+b*x+c*x^2,x],x,0],\r\n        g=Coeff[PolynomialRemainder[Pq,a+b*x+c*x^2,x],x,1]},\r\n  (b*f-2*a*g+(2*c*f-b*g)*x)*(a+b*x+c*x^2)^(p+1)/((p+1)*(b^2-4*a*c)) + \r\n  1/((p+1)*(b^2-4*a*c)) \\[Star] Int[(a+b*x+c*x^2)^(p+1)*ExpandToSum[(p+1)*(b^2-4*a*c)*Q-(2*p+3)*(2*c*f-b*g),x],x]] /;\r\nFreeQ[{a,b,c},x] && PolyQ[Pq,x] && NeQ[b^2-4*a*c,0] && LtQ[p,-1]\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c"],"x"],["PolyQ","Pq","x"],["NeQ",["Add",["Power","b",2],["Multiply",-1,4,"a","c"]],0],["LtQ","p",-1]],"id":4,"result":["With",["List",["Set","Q",["PolynomialQuotient","Pq",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],"x"]],["Set","f",["Coeff",["PolynomialRemainder","Pq",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],"x"],"x",0]],["Set","g",["Coeff",["PolynomialRemainder","Pq",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],"x"],"x",1]]],["Add",["Multiply",["Add",["Multiply","b","f"],["Multiply",-1,2,"a","g"],["Multiply",["Add",["Multiply",2,"c","f"],["Multiply",-1,"b","g"]],"x"]],["Power",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],["Add","p",1]],["Power",["Multiply",["Add","p",1],["Add",["Power","b",2],["Multiply",-1,4,"a","c"]]],-1]],["Star",["Multiply",1,["Power",["Multiply",["Add","p",1],["Add",["Power","b",2],["Multiply",-1,4,"a","c"]]],-1]],["Int",["Multiply",["Power",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],["Add","p",1]],["ExpandToSum",["Add",["Multiply",["Add","p",1],["Add",["Power","b",2],["Multiply",-1,4,"a","c"]],"Q"],["Multiply",-1,["Add",["Multiply",2,"p"],3],["Add",["Multiply",2,"c","f"],["Multiply",-1,"b","g"]]]],"x"]],"x"]]]],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a.",["Multiply","b.","x_"],["Multiply","c.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidat