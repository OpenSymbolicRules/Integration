{"source":"(* ::Code:: *)\r\nInt[Pq_*(a_.+b_.*x_+c_.*x_^2)^p_,x_Symbol] :=\r\n  With[{q=Expon[Pq,x],e=Coeff[Pq,x,Expon[Pq,x]]},\r\n  e*x^(q-1)*(a+b*x+c*x^2)^(p+1)/(c*(q+2*p+1)) + \r\n  1/(c*(q+2*p+1)) \\[Star] Int[(a+b*x+c*x^2)^p*\r\n    ExpandToSum[c*(q+2*p+1)*Pq-a*e*(q-1)*x^(q-2)-b*e*(q+p)*x^(q-1)-c*e*(q+2*p+1)*x^q,x],x]] /;\r\nFreeQ[{a,b,c,p},x] && PolyQ[Pq,x] && NeQ[b^2-4*a*c,0] && Not[LeQ[p,-1]]\r\n\r\n\r\n\r\n","rule":{"constraints":[["FreeQ",["List","a","b","c","p"],"x"],["PolyQ","Pq","x"],["NeQ",["Add",["Power","b",2],["Multiply",-1,4,"a","c"]],0],["Not",["LeQ","p",-1]]],"id":5,"result":["With",["List",["Set","q",["Expon","Pq","x"]],["Set","e",["Coeff","Pq","x",["Expon","Pq","x"]]]],["Add",["Multiply","e",["Power","x",["Add","q",["Multiply",-1,1]]],["Power",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],["Add","p",1]],["Power",["Multiply","c",["Add","q",["Multiply",2,"p"],1]],-1]],["Star",["Multiply",1,["Power",["Multiply","c",["Add","q",["Multiply",2,"p"],1]],-1]],["Int",["Multiply",["Power",["Add","a",["Multiply","b","x"],["Multiply","c",["Power","x",2]]],"p"],["ExpandToSum",["Add",["Multiply","c",["Add","q",["Multiply",2,"p"],1],"Pq"],["Multiply",-1,"a","e",["Add","q",["Multiply",-1,1]],["Power","x",["Add","q",["Multiply",-1,2]]]],["Multiply",-1,"b","e",["Add","q","p"],["Power","x",["Add","q",["Multiply",-1,1]]]],["Multiply",-1,"c","e",["Add","q",["Multiply",2,"p"],1],["Power","x","q"]]],"x"]],"x"]]]],"pattern":["Int",["Multiply","Pq_",["Power",["Add","a.",["Multiply","b.","x_"],["Multiply","c.",["Power","x_",2]]],"p_"]],"x_symbol"]},"status":"candidate","ordinal":5,"required_heads":["Coeff","ExpandToSum","Expon","PolyQ","Set","Star","With"]}
